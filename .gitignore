# ============================================================
# Global .gitignore - applies to the entire repo (backend/ +
# frontend/). Each subfolder also has its own .gitignore for
# its ecosystem (Python / Node). See frontend/.gitignore and
# backend/.gitignore.
# ============================================================

# --- Secrets & environment --------------------------------
# Ignore every real env file; keep the .example templates.
# (A pattern with no slash matches at any depth, so these
# cover backend/.env and frontend/.env alike.)
.env*
!.env.example

# --- OS cruft ---------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editors / IDEs ---------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs --------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*